#include <open.mp> //   Credits to Amir & OMP Team
#include <sscanf2> //  Credits to Y_Less 
#include <streamer> //  Credits to Incognito
#include <zcmd>	// iZCMD, Pawn.CMD, cock.cmd, whatever processor you use

#define FILTERSCRIPT

#define COLOR_USAGE 0xE6E6E6FF
#define COLOR_ERROR 0xFF6666FF
#define COLOR_INFO 0x99CCFFFF


stock CreateLCS2OMPObject(
    modelid,
    Float:x,
    Float:y,
    Float:z,
    Float:rotationX,
    Float:rotationY,
    Float:rotationZ,
    worldid = -1,
    interiorid = -1,
    playerid = -1,
    Float:streamDistance = 1000.0,
    Float:drawDistance = 1000.0
)
{
    return CreateDynamicObject(
        modelid,
        x,
        y,
        z,
        rotationX,
        rotationY,
        rotationZ,
        worldid,
        interiorid,
        playerid,
        streamDistance,
        drawDistance
    );
}


