CMD:gotolc(playerid, params[])
{
    new targetid = playerid;

    if (!isnull(params))
    {
        if (sscanf(params, "u", targetid))
        {
            SendClientMessage(playerid, COLOR_USAGE, "Usage: /gotolc [playerid/name]");
            return 1;
        }

        if (!IsPlayerConnected(targetid))
        {
            SendClientMessage(playerid, COLOR_ERROR, "That player is not connected.");
            return 1;
        }
    }

    SetPlayerPos(targetid, 2469.729980, 4817.979980, 64.709999);

    if (targetid != playerid)
    {
        SendClientMessage(playerid, COLOR_INFO, "Player teleported to Liberty City Stories.");
    }

    return 1;
}

CMD:select(playerid, params[])
{
    #pragma unused params

    BeginObjectSelecting(playerid);
    return 1;
}

CMD:day(playerid, params[])
{
    new hour = 12;

    if (!isnull(params))
    {
        if (sscanf(params, "i", hour))
        {
            SendClientMessage(playerid, COLOR_USAGE, "Usage: /day [hour 0-23]");
            return 1;
        }

        if (hour < 0 || hour > 23)
        {
            SendClientMessage(playerid, COLOR_ERROR, "World time must be from 0 to 23.");
            return 1;
        }
    }

    SetWorldTime(hour);
    return 1;
}

CMD:night(playerid, params[])
{
    new hour = 0;

    if (!isnull(params))
    {
        if (sscanf(params, "i", hour))
        {
            SendClientMessage(playerid, COLOR_USAGE, "Usage: /night [hour 0-23]");
            return 1;
        }

        if (hour < 0 || hour > 23)
        {
            SendClientMessage(playerid, COLOR_ERROR, "World time must be from 0 to 23.");
            return 1;
        }
    }

    SetWorldTime(hour);
    return 1;
}

public OnFilterScriptExit()
{
    return 1;
}

public OnPlayerShootDynamicObject(playerid, weaponid, objectid, Float:x, Float:y, Float:z)
{
    new Float:objectX;
    new Float:objectY;
    new Float:objectZ;
    new Float:rotationX;
    new Float:rotationY;
    new Float:rotationZ;
    new message[128];

    GetDynamicObjectPos(objectid, objectX, objectY, objectZ);
    GetDynamicObjectRot(objectid, rotationX, rotationY, rotationZ);

    new modelid = Streamer_GetIntData(0, objectid, 25);

    format(
        message,
        sizeof(message),
        "ID: %d | Model: %d | Pos: %f, %f, %f, %f, %f, %f",
        objectid,
        modelid,
        objectX,
        objectY,
        objectZ,
        rotationX,
        rotationY,
        rotationZ
    );

    SendClientMessageToAll(-1, message);
    return 1;
}
